# =====================================================
#  Variables de entorno — Gestor Stock / MartoTech
#  Copiá este archivo a `.env` (raíz) y `frontend/.env.local`
#  y completá los valores reales (NO subir secretos a GitHub).
#  Proyecto en Vercel: https://gestorstock-web.vercel.app
# =====================================================

# --- Supabase public values used by Next.js (frontend/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Normalmente apunta al backend local en desarrollo (http://localhost:8000).
# En las variables de entorno de Vercel apunta a https://gestorstock-web.vercel.app
NEXT_PUBLIC_API_URL=https://gestorstock-web.vercel.app

# --- Supabase server values used only by FastAPI (raíz .env) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
SUPERADMIN_EMAIL=tu-correo@ejemplo.com

# Public site URL used for Supabase invitation redirect
SITE_URL=https://gestorstock-web.vercel.app
