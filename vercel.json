{
  "services": {
    "frontend": { "root": "frontend/", "framework": "nextjs" },
    "backend": { "root": "api/", "entrypoint": "index:app" }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
